{
	"$schema": "node_modules/wrangler/config-schema.json",
	// 本番 Worker は1つだけ（手動デプロイ: pnpm run deploy）。PR ごとに Worker Previews（pnpm run preview:pr）で確認する
	"name": "uzulab-portfolio",
	// 個人アカウント（Micata とは別）。誤デプロイ防止のため固定
	"account_id": "874986c440bdf6c4ce420336a70a79a4",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"preview_urls": true,
	// 移行中の仮ドメイン（Access で保護）。切り替え時に ryotanakahara.jp / www に差し替える
	"routes": [{ "pattern": "new.ryotanakahara.jp", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uzulab-portfolio",
			"database_id": "1df7aedc-614a-45c3-8bbf-e9e97d304b59",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "uzulab-portfolio-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "d8bda9b423524e04ab1a901a6c67770c",
		},
	],
	"vars": {
		"AWS_REGION": "ap-northeast-1",
		"MAIL_FROM": "info@ryotanakahara.jp",
		"MAIL_TO": "info@ryotanakahara.jp",
		"CF_ACCESS_AUDIENCE": "b86fc603784be37c9a7db37e8cf98567c0bfde210123c96c91ae74d250427b5f",
	},
	// Secrets（ダッシュボードの Variables and Secrets で登録）: EMDASH_ENCRYPTION_KEY, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger（Previews では動かない）
	"triggers": {
		"crons": ["* * * * *"],
	},
	// Previews は本番と同じ D1 / R2 / KV を使う（データもスキーマも共通）。
	// Secrets はダッシュボードの Previews 設定で本番と同じ値を登録する
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "uzulab-portfolio",
				"database_id": "1df7aedc-614a-45c3-8bbf-e9e97d304b59",
			},
		],
		"r2_buckets": [
			{
				"binding": "MEDIA",
				"bucket_name": "uzulab-portfolio-media",
			},
		],
		"kv_namespaces": [
			{
				"binding": "SESSION",
				"id": "d8bda9b423524e04ab1a901a6c67770c",
			},
		],
		"vars": {
			"AWS_REGION": "ap-northeast-1",
			"MAIL_FROM": "info@ryotanakahara.jp",
			"MAIL_TO": "info@ryotanakahara.jp",
			"CF_ACCESS_AUDIENCE": "b86fc603784be37c9a7db37e8cf98567c0bfde210123c96c91ae74d250427b5f",
		},
	},
}
