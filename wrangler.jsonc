{
	"$schema": "node_modules/wrangler/config-schema.json",
	// トップレベル = prod（手動デプロイ: pnpm deploy:prod）。stg は env.stg（main マージで GitHub Actions から自動デプロイ）
	// 環境ごとに bindings / vars / routes は継承されないので、env.stg 側にも全て書く
	"name": "uzulab-portfolio",
	// 個人アカウント（Micata とは別）。誤デプロイ防止のため固定
	"account_id": "874986c440bdf6c4ce420336a70a79a4",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "uzulab-portfolio",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "uzulab-portfolio-media",
		},
	],
	"vars": {
		"AWS_REGION": "ap-northeast-1",
		"MAIL_FROM": "info@ryotanakahara.jp",
		"MAIL_TO": "info@ryotanakahara.jp",
	},
	// Secrets（wrangler secret put で登録）: EMDASH_ENCRYPTION_KEY, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
	"env": {
		"stg": {
			"name": "uzulab-portfolio-stg",
			"routes": [{ "pattern": "stg.ryotanakahara.jp", "custom_domain": true }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "uzulab-portfolio-stg",
					"database_id": "8dd045bf-7a46-4e49-b996-16dfe807475c",
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA",
					"bucket_name": "uzulab-portfolio-media-stg",
				},
			],
			"kv_namespaces": [
				{
					"binding": "SESSION",
					"id": "5e92f7ecc395425a9ea179a75ee44d59",
				},
			],
			"vars": {
				"AWS_REGION": "ap-northeast-1",
				"MAIL_FROM": "info@ryotanakahara.jp",
				"MAIL_TO": "info@ryotanakahara.jp",
			},
			"triggers": {
				"crons": ["* * * * *"],
			},
		},
	},
}
