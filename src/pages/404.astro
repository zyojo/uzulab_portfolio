---
import Base from '../layouts/Base.astro'
---

<Base title='Not Found' robots='noindex'>
  <section class='notFound'>
    <h1 class='notFound_title avenir-bold'>404</h1>
    <p>お探しのページは見つかりませんでした。</p>
    <a href='/' class='notFound_link avenir-bold'>back to top</a>
  </section>
</Base>

<style lang='scss'>
  @use '../styles/variables' as *;

  .notFound {
    margin: 80px auto 0;
    text-align: center;
    &_title {
      font-size: 34px;
      margin-bottom: 16px;
    }
    &_link {
      display: inline-block;
      margin-top: 40px;
      color: $text-brown-hover;
      border-bottom: 2px dotted $border-theme;
    }
  }
</style>
