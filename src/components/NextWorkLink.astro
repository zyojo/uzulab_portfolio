---
import { Image } from 'emdash/ui'
import type { Work } from '../lib/works'

interface Props {
  work: Work
  isPrev?: boolean
  /** next と並ぶときは上に詰めて互い違いに配置する */
  hasNext?: boolean
}

const { work, isPrev = false, hasNext = false } = Astro.props
---

<a
  href={`/work/${work.entry.id}`}
  class='nextWorkLink'
  data-isprev={String(isPrev)}
  data-stacked={String(isPrev && hasNext)}
>
  <div class='nextWorkLink_img'>
    <Image image={work.entry.data.featured_image} alt={work.entry.data.title} />
  </div>
  <div class='nextWorkLink_info'>
    <div class='nextWorkLink_info_title avenir-bold'>{work.entry.data.title}</div>
    <div class='nextWorkLink_info_arrow avenir-bold'>{isPrev ? 'prev' : 'next'}</div>
  </div>
</a>

<style lang='scss'>
  @use '../styles/variables' as *;
  @use 'sass:map';

  .nextWorkLink {
    display: flex;
    justify-content: space-between;
    flex-direction: row-reverse;
    margin-right: auto;
    border-radius: $br-md;
    background-color: rgba($theme-white, 1);
    transition: background-color 0.3s ease-out;
    overflow: hidden;
    width: calc(#{columnWidth(6, 'dt')} - 8px);
    margin-left: calc(#{columnWidth(5, 'dt')} + #{map.get($column-gutter, 'dt')} + 8px);
    @include media-query('pc') {
      width: calc(#{columnWidth(6, 'pc')} - 8px);
      margin-left: calc(#{columnWidth(5, 'pc')} + #{map.get($column-gutter, 'pc')} + 8px);
    }
    @include media-query('tb') {
      flex-direction: column;
      width: calc(#{columnWidth(6, 'tb')} - 8px);
      margin-left: calc(#{columnWidth(5, 'tb')} + #{map.get($column-gutter, 'tb')} + 8px);
    }
    @include media-query('sp') {
      width: calc(#{columnWidth(6, 'sp')} + 8px);
      margin-left: calc(#{columnWidth(6, 'sp')} + #{map.get($column-gutter, 'sp')});
    }
    &_img {
      height: 144px;
      aspect-ratio: 3/2;
      flex-shrink: 0;
      filter: saturate(0.8) contrast(0.97) opacity(0.8);
      transition: filter 0.4s ease-out;
      @include media-query('tb') {
        filter: saturate(1) contrast(1) opacity(1);
        height: auto;
      }
      :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
    &_info {
      flex-grow: 1;
      display: flex;
      justify-content: space-between;
      flex-direction: column;
      padding: 32px 40px 24px;
      @include media-query('sp') {
        padding: 16px 24px 16px;
      }
      &_title {
        font-size: 18px;
        word-break: break-all;
        transition: color 0.7s ease-out;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
        @include media-query('tb') {
          margin-bottom: 16px;
        }
        @include media-query('sp') {
          font-size: 16px;
          margin-bottom: 4px;
        }
      }
      &_arrow {
        text-align: right;
        color: $theme-gray;
        position: relative;
        @include media-query('sp') {
          font-size: 11px;
        }
        &::after {
          content: '';
          display: block;
          height: 1px;
          background-color: $border-theme;
          border-radius: 99px;
          position: absolute;
          left: 40px;
          right: 40px;
          top: 50%;
          transform: translateY(-50%);
          transition: all 0.3s ease-in-out;
          @include media-query('tb') {
            left: 32px;
          }
        }
      }
    }
    &[data-isprev='true'] {
      flex-direction: row;
      margin-right: auto;
      margin-left: calc((#{columnWidth(1, 'dt')} + #{map.get($column-gutter, 'dt')}) * -1);
      @include media-query('pc') {
        margin-left: calc((#{columnWidth(1, 'pc')} + #{map.get($column-gutter, 'pc')}) * -1);
      }
      @include media-query('tb') {
        flex-direction: column;
        margin-left: calc((#{columnWidth(1, 'tb')} + #{map.get($column-gutter, 'tb')}) * -1);
      }
      @include media-query('sp') {
        margin-left: calc(-8px);
      }
      .nextWorkLink_info_title {
        text-align: right;
      }
      .nextWorkLink_info_arrow {
        text-align: left;
      }
    }
    &[data-stacked='true'] {
      margin-top: -96px;
      @include media-query('sp') {
        margin-top: -176px;
      }
    }
    &:hover {
      background-color: rgba($color: $theme-white, $alpha: 0.8);
      .nextWorkLink_img {
        filter: saturate(1) contrast(1) opacity(1);
      }
      .nextWorkLink_info_title {
        color: $text-brown-hover;
      }
      .nextWorkLink_info_arrow::after {
        left: 80px;
        right: 40px;
      }
    }
    &[data-isprev='true']:hover .nextWorkLink_info_arrow::after {
      left: 40px;
      right: 80px;
    }
  }
</style>
