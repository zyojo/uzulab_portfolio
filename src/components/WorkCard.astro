---
import type { MediaValue } from 'emdash'
import { Image } from 'emdash/ui'
import { formatWorkDuration } from '../lib/format'
import Tag from './Tag.astro'

interface Props {
  href: string
  title: string
  subtitle?: string
  thumbnail: MediaValue
  startDate?: string
  endDate?: string
  tags: { slug: string; label: string }[]
}

const { href, title, subtitle, thumbnail, startDate, endDate, tags } = Astro.props
---

<li class='work' data-tags={tags.map((t) => t.slug).join(' ')}>
  <a href={href} class='work_container'>
    <div class='work_thumb'>
      <Image image={thumbnail} alt={title} class='work_thumb_img' />
      <div class='work_thumb_tags'>
        {tags.map((tag) => <Tag label={tag.label} />)}
      </div>
    </div>
    <div class='work_info'>
      <h2 class='work_info_title avenir-bold'>{title}</h2>
      <div class='work_info_duration avenir-bold'>{formatWorkDuration(startDate, endDate)}</div>
      {subtitle && <div class='work_info_desc'>{subtitle}</div>}
    </div>
  </a>
</li>

<script>
  // 画面の中央付近にあるカードだけ色を戻し、離れるほどグレーにする
  const works = document.querySelectorAll<HTMLElement>('.work')
  const mobile = window.matchMedia('(max-width: 450px)')
  const SPEED_TO_ACTIVATE = 5

  const grayRate = (top: number, windowHeight: number) => {
    const activeZoneTop = windowHeight * (mobile.matches ? -0.05 : -0.2)
    const activeZoneBottom = windowHeight * 0.6
    if (top < activeZoneBottom && activeZoneTop < top) return 0
    const distance = top <= activeZoneTop ? activeZoneTop - top : top - activeZoneBottom
    return Math.min(1, (distance / windowHeight) * SPEED_TO_ACTIVATE)
  }

  const update = () => {
    const windowHeight = window.innerHeight
    for (const work of works) {
      const rate = grayRate(work.getBoundingClientRect().top, windowHeight)
      work.style.setProperty('--gray-rate', String(rate))
    }
  }

  update()
  window.addEventListener('scroll', update, { passive: true })
  window.addEventListener('resize', update)
</script>

<style lang='scss'>
  @use '../styles/variables' as *;

  .work {
    --gray-rate: 1;
    --thumb-opacity: calc(0.6 + (1 - var(--gray-rate)) * 0.3);
    display: block;
    background-color: rgba(255, 255, 255, calc(var(--thumb-opacity) * 0.5));
    color: $text-black-light;
    border-radius: $br-md;
    cursor: pointer;
    transition: all 0.15s ease-out;
    @include media-query('tb') {
      color: $text-black;
    }
    &[hidden] {
      display: none;
    }
    &_thumb {
      position: relative;
      background-color: $disabled-gray;
      width: 100%;
      aspect-ratio: 3 / 2;
      margin-bottom: 32px;
      border-radius: $br-sm;
      overflow: hidden;
      transform: translateZ(0); // for safari
      @include media-query('tb') {
        margin-bottom: 24px;
      }
      :global(.work_thumb_img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: all 0.3s ease-out;
        transform: translateZ(0); // for safari
        filter: opacity(var(--thumb-opacity)) grayscale(calc(var(--gray-rate) * 0.5))
          sepia(calc(var(--gray-rate) * 0.05));
      }
      &_tags {
        display: flex;
        gap: 8px;
        position: absolute;
        z-index: 2;
        top: 16px;
        right: 16px;
        opacity: var(--thumb-opacity);
        transform: translateZ(0); // for safari
        @include media-query('pc') {
          top: 8px;
          right: 8px;
        }
      }
    }
    &_info {
      width: 100%;
      padding: 0 32px;
      opacity: calc(1 - var(--gray-rate) * 0.4);
      @include media-query('tb') {
        padding: 0 16px;
      }
      &_title {
        font-size: 28px;
        @include media-query('tb') {
          font-size: 20px;
          margin-bottom: 8px;
          line-height: 1.35;
        }
      }
      &_duration {
        font-size: 14px;
        @include media-query('tb') {
          font-size: 12px;
        }
      }
      &_desc {
        margin-top: 16px;
        font-size: 14px;
        line-height: calc(32 / 14);
        @include media-query('tb') {
          font-size: 13px;
          line-height: 2;
        }
        @include media-query('sp') {
          margin-top: 8px;
          font-size: 12px;
        }
      }
    }
    &:hover {
      background-color: $content-bg-white-hover !important;
      color: $text-black !important;
      :global(.work_thumb_img) {
        filter: opacity(1) grayscale(0) sepia(0) !important;
      }
      .work_info {
        opacity: 1;
      }
    }
    &_container {
      display: block;
      padding: 16px 16px 64px;
      @include media-query('tb') {
        padding: 8px 8px 48px;
      }
    }
  }
</style>
